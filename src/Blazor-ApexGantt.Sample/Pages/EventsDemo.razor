@page "/events-demo"
@using Blazor_ApexGantt.Components
@using Blazor_ApexGantt.Models

<PageTitle>Events Demo</PageTitle>

<h1>ApexGantt Events Demo</h1>
<p>
    Edit, drag, or resize tasks to see all events in action. Each update names its source
    (drag, resize, progress, dialog, inline, keyboard or api).
</p>

<div class="mb-3 d-flex flex-wrap gap-2 api-buttons">
    <button class="btn btn-sm btn-outline-primary" id="btn-read-data" @onclick="ReadData">Read chart data</button>
    <button class="btn btn-sm btn-outline-primary" id="btn-update-api" @onclick="() => SetTestingProgress(false)">Set Testing progress</button>
    <button class="btn btn-sm btn-outline-primary" id="btn-update-silent" @onclick="() => SetTestingProgress(true)">Set Testing progress (silent)</button>
    <button class="btn btn-sm btn-outline-primary" id="btn-collapse" @onclick="Collapse">Collapse release</button>
    <button class="btn btn-sm btn-outline-primary" id="btn-scroll" @onclick="ScrollToDeployment">Scroll to Deployment</button>
    <button class="btn btn-sm btn-outline-primary" id="btn-dark" @onclick="ToggleTheme">Toggle theme (keeps edits)</button>
</div>
<p class="text-muted" id="api-status">@apiStatus</p>

<div class="mb-4">
    <ApexGantt 
        @ref="gantt"
        Options="@eventsOptions" 
        Tasks="@tasks"
        OnTaskUpdate="@HandleTaskUpdate"
        OnTaskUpdateSuccess="@HandleTaskUpdateSuccess"
        OnTaskUpdateError="@HandleTaskUpdateError"
        OnTaskValidationError="@HandleTaskValidationError"
        OnTaskDragged="@HandleTaskDragged"
        OnTaskResized="@HandleTaskResized" />
</div>

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Event Log</h5>
                <button class="btn btn-sm btn-outline-secondary" @onclick="ClearEventLog">Clear</button>
            </div>
            <div class="card-body event-log">
                @if (!eventLog.Any())
                {
                    <p class="text-muted">No events yet. Try editing, dragging, or resizing a task!</p>
                }
                else
                {
                    @foreach (var logEntry in eventLog.OrderByDescending(e => e.Timestamp))
                    {
                        <div class="event-entry @logEntry.Type">
                            <div class="event-type">@logEntry.Type.ToUpper()</div>
                            <div class="event-time">@logEntry.TimeFormatted</div>
                            <div class="event-details">@logEntry.Message</div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<style>
    .event-log {
        max-height: 500px;
        overflow-y: auto;
        font-size: 0.875rem;
    }
    
    .event-entry {
        padding: 0.75rem;
        margin-bottom: 0.5rem;
        border-radius: 4px;
        border-left: 4px solid;
    }
    
    .event-entry.update {
        background-color: #e3f2fd;
        border-left-color: #2196f3;
    }
    
    .event-entry.success {
        background-color: #e8f5e9;
        border-left-color: #4caf50;
    }
    
    .event-entry.error {
        background-color: #ffebee;
        border-left-color: #f44336;
    }
    
    .event-entry.validation {
        background-color: #fff3e0;
        border-left-color: #ff9800;
    }

    .event-entry.dragged {
        background-color: #f3e5f5;
        border-left-color: #9c27b0;
    }
    
    .event-entry.resized {
        background-color: #e0f2f1;
        border-left-color: #009688;
    }
    
    .event-type {
        font-weight: 600;
        margin-bottom: 0.25rem;
    }
    
    .event-time {
        font-size: 0.75rem;
        color: #666;
        margin-bottom: 0.25rem;
    }
    
    .event-details {
        font-size: 0.875rem;
    }
    
    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
</style>

@code {
    private GanttOptions eventsOptions = new()
    {
        Width = "100%",
        Height = "450px",
        InputDateFormat = "YYYY-MM-DD", // matches how the wrapper writes DateTime values

        // enable editing to trigger events
        EnableTaskCRUDToolbar = true,
        EnableTaskDrag = true,
        EnableTaskResize = true,
        EnableTaskEdit = true,

        // styling
        BarBorderRadius = "6px",
        RowHeight = 32
    };

    private List<GanttTask> tasks = new()
    {
        // a parent with no dates: its summary bar spans its children
        new GanttTask { Id = "release", Name = "Release 1.0" },
        new GanttTask
        {
            Id = "task1",
            ParentId = "release",
            Name = "Planning Phase",
            StartTime = DateTime.Now,
            EndTime = DateTime.Now.AddDays(5),
            Progress = 100,
            BarBackgroundColor = "#10b981"
        },
        new GanttTask
        {
            Id = "task2",
            ParentId = "release",
            Name = "Development",
            StartTime = DateTime.Now.AddDays(5),
            EndTime = DateTime.Now.AddDays(15),
            Progress = 60,
            Dependency = "task1",
            BarBackgroundColor = "#3b82f6"
        },
        new GanttTask
        {
            Id = "task3",
            ParentId = "release",
            Name = "Testing",
            StartTime = DateTime.Now.AddDays(15),
            EndTime = DateTime.Now.AddDays(20),
            Progress = 30,
            Dependency = "task2",
            BarBackgroundColor = "#8b5cf6"
        },
        new GanttTask
        {
            Id = "task4",
            ParentId = "release",
            Name = "Deployment",
            StartTime = DateTime.Now.AddDays(20),
            EndTime = DateTime.Now.AddDays(22),
            Progress = 0,
            Dependency = "task3",
            BarBackgroundColor = "#ef4444"
        }
    };

    private class EventLogEntry
    {
        public string Type { get; set; } = string.Empty;
        public string Message { get; set; } = string.Empty;
        public long Timestamp { get; set; }
        public string TimeFormatted => DateTimeOffset.FromUnixTimeMilliseconds(Timestamp)
            .LocalDateTime
            .ToString("HH:mm:ss");
    }

    private List<EventLogEntry> eventLog = new();
    private ApexGantt? gantt;
    private string apiStatus = "";
    private int progressStep;

    private async Task ReadData()
    {
        var all = await gantt!.GetTasksAsync();
        var links = await gantt.GetDependenciesAsync();
        var testing = await gantt.GetTaskAsync("task3");
        apiStatus = $"{all.Count} tasks, {links.Count} links; Testing is at level {testing?.Level}, {testing?.Progress}%";
    }

    private async Task SetTestingProgress(bool silent)
    {
        progressStep = (progressStep + 1) % 10;
        await gantt!.UpdateTaskAsync("task3", new GanttTask { Progress = progressStep * 10 }, silent);
        var testing = await gantt.GetTaskAsync("task3");
        apiStatus = $"Testing set to {testing?.Progress}%{(silent ? " silently" : "")}";
    }

    private async Task Collapse()
    {
        var done = await gantt!.CollapseTaskAsync("release");
        apiStatus = $"collapsed: {done}";
    }

    private async Task ScrollToDeployment()
    {
        var shown = await gantt!.ScrollToTaskAsync("task4");
        apiStatus = $"scrolled: {shown}";
    }

    private async Task ToggleTheme()
    {
        eventsOptions.Theme = eventsOptions.Theme == ThemeMode.Dark ? ThemeMode.Light : ThemeMode.Dark;
        // the task list has not changed, so this leaves the chart's data and undo history alone
        await gantt!.UpdateAsync();
        var testing = await gantt.GetTaskAsync("task3");
        apiStatus = $"theme {eventsOptions.Theme}; Testing still at {testing?.Progress}%";
    }

    private void HandleTaskUpdate(TaskUpdateEventArgs args)
    {
        eventLog.Add(new EventLogEntry
        {
            Type = "update",
            Message = $"Task '{args.TaskId}' is being updated (source: {args.Source})",
            Timestamp = args.Timestamp
        });
        StateHasChanged();
    }

    private void HandleTaskUpdateSuccess(TaskUpdateSuccessEventArgs args)
    {
        var task = args.UpdatedTask;
        eventLog.Add(new EventLogEntry
        {
            Type = "success",
            Message = $"Task '{args.TaskId}' updated successfully (source: {args.Source}). Name: {task?.Name}, Progress: {task?.Progress}%",
            Timestamp = args.Timestamp
        });
        StateHasChanged();
    }

    private void HandleTaskUpdateError(TaskUpdateErrorEventArgs args)
    {
        eventLog.Add(new EventLogEntry
        {
            Type = "error",
            Message = $"Task '{args.TaskId}' update failed: {args.ErrorMessage}",
            Timestamp = args.Timestamp
        });
        StateHasChanged();
    }

    private void HandleTaskValidationError(TaskValidationErrorEventArgs args)
    {
        var errorMessages = string.Join(", ", args.Errors.Select(e => $"{e.Field}: {e.Message}"));
        eventLog.Add(new EventLogEntry
        {
            Type = "validation",
            Message = $"Task '{args.TaskId}' validation failed: {errorMessages}",
            Timestamp = args.Timestamp
        });
        StateHasChanged();
    }

    private void HandleTaskDragged(TaskDraggedEventArgs args)
    {
        eventLog.Add(new EventLogEntry
        {
            Type = "dragged",
            Message = $"Task '{args.TaskId}' dragged {args.DaysMoved} days ({args.OldStartTime} → {args.NewStartTime})",
            Timestamp = args.Timestamp
        });
        StateHasChanged();
    }

    private void HandleTaskResized(TaskResizedEventArgs args)
    {
        eventLog.Add(new EventLogEntry
        {
            Type = "resized",
            Message = $"Task '{args.TaskId}' resized using {args.ResizeHandle} handle, duration changed by {args.DurationChange} days",
            Timestamp = args.Timestamp
        });
        StateHasChanged();
    }

    private void ClearEventLog()
    {
        eventLog.Clear();
    }
}
